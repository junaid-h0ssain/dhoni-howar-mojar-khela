# WebSocket endpoint for the game backend.
#
# Baked in at build time (SvelteKit PUBLIC_*). Local vs global:
#
#   Local dev (default when unset on localhost):
#     (leave empty — the app auto-uses ws://<host>:8080/ws)
#     # PUBLIC_WS_URL=ws://localhost:8080/ws
#
#   Production (set in your Vercel project settings → Environment Variables):
#     PUBLIC_WS_URL=wss://dhmk.onrender.com/ws
#
# PUBLIC_WS_URL=
