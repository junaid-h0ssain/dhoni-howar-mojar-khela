# Room storage for the SvelteKit polling backend.
#
# PRODUCTION (Vercel → Environment Variables): set both so rooms are shared
# across serverless instances and survive deploys. Without these, rooms live
# in server memory and WILL vanish when Vercel shifts/cold-starts instances.
#
# From your Upstash console → your database → "REST API" section
# (same database the Go backend uses via REDIS_URL also works):
#
# UPSTASH_REDIS_REST_URL=https://sharing-roughy-XXXX.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
#
# LOCAL DEV: leave both empty for the zero-config in-memory store
# (rooms survive reloads within the running process only).
#
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Legacy: Go WebSocket backend endpoint (unused by the polling version,
# kept so the frozen back/ code can be revived later).
# PUBLIC_WS_URL=
