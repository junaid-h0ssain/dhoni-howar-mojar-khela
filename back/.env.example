PORT=8080
# Upstash Redis. REQUIRED in production: games + seat tokens persist here for
# 24h so reloads, app-switches, and deploys never wipe progress.
# Local dev: leave empty for the zero-config in-memory store (survives reloads
# within this process, but not a backend restart — set REDIS_URL to test the
# real persistence path locally).
REDIS_URL=
REDIS_PASSWORD=
# Comma-separated browser origins allowed to open WebSockets, e.g.:
# ALLOWED_ORIGINS=https://mahajoni.vercel.app
ALLOWED_ORIGINS=https://dhoni-khela.vercel.app/
